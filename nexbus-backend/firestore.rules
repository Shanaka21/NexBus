rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function operatorId() { return request.auth.token.operatorId; }

    // Every write goes through the API (Admin SDK bypasses these rules)
    match /{document=**} { allow write: if false; }

    // Reference data and live bus state are readable by signed-in users
    match /routes/{id}     { allow read: if signedIn(); }
    match /bus_stops/{id}  { allow read: if signedIn(); }
    match /vehicles/{id}   { allow read: if signedIn(); }
    match /trips/{id}      { allow read: if signedIn(); }

    match /bookings/{id} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        (role() == 'operator' && resource.data.operator_id == operatorId())
      );
    }

    match /payments/{id} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        (role() == 'operator' && resource.data.operator_id == operatorId())
      );
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
    }

    // operators, location_logs and system_logs: no client access (API only)
  }
}
