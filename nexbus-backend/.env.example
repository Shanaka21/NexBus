PORT=5000
# Postgres connection string (Neon or any Postgres). sslmode=require is needed for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Secret used to sign access/refresh-related JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public URL of the web dashboard; used to build the (currently console-logged) password reset link.
APP_URL=http://localhost:5173
# OAuth client id(s) used to verify Google sign-in id tokens from the mobile app (expo-auth-session).
# Comma-separate multiple ids if the app uses different client ids per platform (web/Android/iOS).
GOOGLE_CLIENT_ID=
DASHBOARD_ORIGIN=http://localhost:5173
# PayHere (sandbox). Never ship the secret in the mobile app.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Sandbox helper endpoint that completes a payment without a public notify URL. Keep false in production.
PAYHERE_SIMULATE=false
# Public HTTPS address of this API; PayHere posts payment notifications to API_BASE_URL/payments/notify
API_BASE_URL=http://localhost:5000
# Shared secret for Cloud Scheduler calls to /internal/*
INTERNAL_JOB_TOKEN=
# false on Cloud Run (use Cloud Scheduler instead of the built-in timers)
ENABLE_JOBS=true
# NVIDIA API key (build.nvidia.com) for the Plan Trip assistant. Server side only: never put it in the mobile app.
NVIDIA_API_KEY=
# Optional: chat model used to understand the passenger's request
NVIDIA_MODEL=
