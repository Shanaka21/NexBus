                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@nexbus.lk\"\n}"
            }
          }
        },
        {
          "name": "Firebase custom token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/firebase-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "firebase-token"
              ]
            }
          }
        }
      ]
